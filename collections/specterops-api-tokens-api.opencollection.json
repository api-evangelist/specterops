{
  "opencollection": "1.0.0",
  "info": {
    "name": "BloodHound AD Base Entities API Tokens API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Auth Tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/tokens",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "query",
                "description": "Provide a `user_id` to filter tokens by. Admin users may filter by any `user_id`. Non-admin users may only filter by their own `user_id` using `eq`."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "Sortable columns are `user_id`, `client_id`, `name`, `last_access`, `created_at`, `updated_at`, `deleted_at`.\n"
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "key",
                "value": "",
                "type": "query"
              },
              {
                "name": "hmac_method",
                "value": "",
                "type": "query"
              },
              {
                "name": "last_access",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_at",
                "value": "",
                "type": "query",
                "description": "Filter results by `created_at` value. See filter schema details for valid predicates."
              },
              {
                "name": "updated_at",
                "value": "",
                "type": "query",
                "description": "Filter results by `updated_at` value. See filter schema details for valid predicates."
              },
              {
                "name": "deleted_at",
                "value": "",
                "type": "query",
                "description": "Filter results by `deleted_at` value. See filter schema details for valid predicates."
              }
            ]
          },
          "docs": "Get all auth tokens."
        },
        {
          "info": {
            "name": "Create Token for User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v2/tokens",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new token to use with request signing based authentication for a given user."
        },
        {
          "info": {
            "name": "Delete a User Token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v2/tokens/:token_id",
            "headers": [
              {
                "name": "Prefer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "token_id",
                "value": "",
                "type": "path",
                "description": "ID of auth token to delete."
              }
            ]
          },
          "docs": "Delete a request signing token for a given user."
        }
      ]
    }
  ],
  "bundled": true
}